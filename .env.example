# All settings use the SELLO_ prefix (see app/core/config.py).
SELLO_DATABASE_URL=sqlite+aiosqlite:///./sello.db
# SELLO_DATABASE_URL=postgresql+asyncpg://sello:sello@localhost:5432/sello
SELLO_JWT_SECRET=change-me
# Fernet key for channel credentials and AI keys; derived from JWT secret when empty (dev only).
SELLO_CREDENTIALS_KEY=
SELLO_CORS_ORIGINS=["http://localhost:3000"]
SELLO_PUBLIC_BASE_URL=http://localhost:8000
SELLO_OTP_DEV_MODE=true
SELLO_ADMIN_PHONES=["09120000000"]
SELLO_INSTAGRAM_ENABLED=false
