# Copy to DEPLOY_PATH/.env on the server (cp env.example .env) and fill in.
# Public address of the site, with no trailing slash: http://SERVER_IP:8200 now, https://your.domain later.
SELLO_PUBLIC_BASE_URL=http://SERVER_IP:8200
SELLO_FRONTEND_BASE_URL=http://SERVER_IP:8200
SELLO_CORS_ORIGINS=["http://SERVER_IP:8200"]
# Ports on 127.0.0.1 that nginx forwards to (must match nginx-sello.conf).
BACKEND_PORT=8100
FRONTEND_PORT=3100

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
SELLO_JWT_SECRET=
# Fernet key: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it forever: channel credentials and AI keys are encrypted with it.
SELLO_CREDENTIALS_KEY=

SELLO_ADMIN_PHONES=["09120000000"]
# true shows the login code on screen (no SMS). Set false once SELLO_SMS_PROVIDER/SELLO_SMS_API_KEY are set.
SELLO_OTP_DEV_MODE=true
# SELLO_SMS_PROVIDER=kavenegar
# SELLO_SMS_API_KEY=

# Images on S3-compatible storage (ArvanCloud, AWS, MinIO...). SELLO_STORAGE=local keeps them on the server disk.
SELLO_STORAGE=s3
SELLO_S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir
SELLO_S3_REGION=
SELLO_S3_BUCKET=
SELLO_S3_ACCESS_KEY=
SELLO_S3_SECRET_KEY=
# Public bucket: its base address (images load straight from it). Empty: private bucket, signed links.
SELLO_S3_PUBLIC_URL=

SELLO_INSTAGRAM_ENABLED=false
SELLO_CHAT_TRANSPORT=polling
